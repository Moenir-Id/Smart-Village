# =====================
# PARAMETER SISTEM
# =====================
# SLA dalam jam (72 = 3 hari kerja)
SLA_JAM=72

# Auto-purge foto KTP/KK (dalam hari setelah selesai)
PURGE_FOTO_HARI=30

# Anti-spam: max pengajuan per NIK per jam
SPAM_MAX_PER_JAM=3

# Ukuran maks foto upload (KB)
FOTO_MAX_KB=5120

# Target kompresi foto (KB)
FOTO_TARGET_KB=200

# Auto-logout admin (menit)
AUTO_LOGOUT_MENIT=15

# =====================
# WHATSAPP GATEWAY
# =====================
WA_NOMOR_DINAS="6285893009419"
WA_NOTIF_AKTIF=true
WA_TEMPLATE_PESAN="Halo {nama}, permohonan surat Anda dengan kode {kode_unik} telah {status}."

# =====================
# SANCTUM / API
# =====================
SANCTUM_STATEFUL_DOMAINS=smart-village.test

# =====================
# VITE (Frontend)
# =====================
VITE_APP_NAME="${APP_NAME}"
VITE_DESA_NAMA="${DESA_NAMA}"
VITE_DESA_WARNA_PRIMER="${DESA_WARNA_PRIMER}"
VITE_DESA_WARNA_SEKUNDER="${DESA_WARNA_SEKUNDER}"
