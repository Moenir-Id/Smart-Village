# =====================
# IDENTITAS DESA
# =====================
DESA_NAMA="Desa Carangrejo"
DESA_KECAMATAN="Kecamatan Sampung"
DESA_KABUPATEN="Kota Ponorogo"
DESA_PROVINSI="Jawa Timur"
